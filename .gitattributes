# Chuẩn hóa line ending: repo luôn lưu LF, bất kể hệ điều hành của người commit
* text=auto eol=lf

# Script Windows cần CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Script shell phải là LF để chạy được trên Linux/macOS/CI
mvnw text eol=lf
*.sh text eol=lf

# File nhị phân: không chuẩn hóa, không diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
