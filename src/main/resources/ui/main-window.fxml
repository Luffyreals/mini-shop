<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.minishop.desktop.MainWindow" styleClass="window">

    <VBox fx:id="shell" spacing="16">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <!-- Thanh trên nổi: nền surface, bo 28, bóng theo token. minWidth="-Infinity" là USE_PREF_SIZE:
             chữ không bị co thành "…" khi cửa sổ hẹp. Ngân sách (QĐ15 của D6; số đo bằng FXMLLoader + theme.css,
             phông Plus Jakarta Sans). Cửa sổ 1024 px có khung Windows chỉ còn scene ~1008 px, nên tính ở 1008 px:
             thanh trong 940 px (1008 - 2 x 16 đệm cửa sổ - 36 đệm thanh). Cố định: logo 105 + 3 nút điều hướng 313 +
             giỏ 52 + 6 khoảng cách 6 = 506 px. Còn 434 px cho ô tìm kiếm và nút tài khoản:
               - nút tài khoản: "Quản trị viên" cần 126 px, "Khách hàng mẫu" cần 154 px (chữ + đệm 16 hai bên +
                 viền 2 hai bên); CSS cho tối đa 168 px, tên dài hơn bị cắt bằng "…";
               - ô tìm kiếm: chữ gợi ý "Tìm sản phẩm theo tên…" rộng 167,5 px + đệm 42 trái + 60 phải (chừa nhãn
                 "Ctrl K" 48 px + lề 10) + viền 4 = 273,5 px, nên prefWidth 276 (còn 170 px cho chữ gợi ý);
                 minWidth 268 chỉ để HBox còn chỗ co khi cửa sổ hẹp hơn.
             Cộng lại ở scene 1008 px: 506 + 276 + 154 = 936 px so với 940 px (dư 4 px): cả hai tên demo, gợi ý và
             "Ctrl K" hiện đủ, không ai bị co. Hẹp hơn nữa HBox chia đều phần thiếu cho nút tài khoản (min 96) và ô
             tìm kiếm: ở scene 992 px "Khách hàng mẫu" còn 148 px và bị cắt "…" nhẹ (đọc đủ qua accessibleText).
             Tên dài (tối đa 24 ký tự, ShellPresenter) bị cắt "…" ở 168 px; không dùng minWidth USE_PREF_SIZE cho nút
             này vì min thắng max của CSS và nút sẽ rộng 253 px làm tràn thanh -->

        <HBox fx:id="topBar" styleClass="card, top-bar" alignment="CENTER_LEFT" spacing="6">
            <HBox fx:id="logo" styleClass="logo" alignment="CENTER_LEFT" spacing="4">
                <Label text="mini shop" styleClass="logo-text" minWidth="-Infinity"/>
                <Region styleClass="logo-dot" minWidth="8" minHeight="8" prefWidth="8" prefHeight="8"
                        maxWidth="8" maxHeight="8"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="2">
                <Button fx:id="navStore" text="Cửa hàng" styleClass="nav-link" minWidth="-Infinity"/>
                <Button fx:id="navNew" text="Hàng mới" styleClass="nav-link" minWidth="-Infinity"/>
                <Button fx:id="navCategories" text="Danh mục" styleClass="nav-link" minWidth="-Infinity"
                        contentDisplay="RIGHT" graphicTextGap="6">
                    <graphic>
                        <SVGPath content="M1 1.5 L5 5.5 L9 1.5" styleClass="icon-stroke"/>
                    </graphic>
                </Button>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Ô tìm kiếm dạng pill; biểu tượng chồng lên trên ô nhập -->
            <StackPane fx:id="searchBox" styleClass="search-box" minWidth="268" prefWidth="276"
                       maxWidth="420">
                <TextField fx:id="searchField" styleClass="search-field, pill"
                           promptText="Tìm sản phẩm theo tên…" accessibleText="Tìm sản phẩm theo tên"
                           accessibleHelp="Ctrl K"/>
                <SVGPath content="M9.5 2.5a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M14.5 14.5 L19 19"
                         styleClass="icon-stroke, search-icon" mouseTransparent="true"
                         StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets left="16"/>
                    </StackPane.margin>
                </SVGPath>
                <!-- Gợi ý phím tắt Ctrl+K; không nhận chuột, chuột xuyên qua tới ô nhập -->
                <Label fx:id="searchShortcut" text="Ctrl K" styleClass="search-shortcut, text-caption"
                       mouseTransparent="true" StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="10"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Nút giỏ tròn đen, badge accent ở góc trên phải -->
            <StackPane styleClass="cart-wrap">
                <Button fx:id="cartButton" styleClass="cart-button, pill"
                        accessibleText="Giỏ hàng, 0 sản phẩm">
                    <graphic>
                        <SVGPath content="M5 8h14l-1.2 11H6.2z M9 8V7a3 3 0 0 1 6 0v1"
                                 styleClass="icon-stroke, cart-icon"/>
                    </graphic>
                </Button>
                <Label fx:id="cartBadge" text="0" styleClass="cart-badge, pill"
                       mouseTransparent="true" StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <Button fx:id="accountButton" text="Đăng nhập" styleClass="account-button, pill" minWidth="96"/>
        </HBox>

        <!-- Vùng nội dung; Navigator (F2) thay node ở đây -->
        <StackPane fx:id="content" styleClass="content" VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Lớp drawer (D4): nằm trên thanh trên và nội dung, dưới lớp toast để toast hiện trên drawer. Khi đóng
         lớp này rỗng và không nhận chuột (pickOnBounds="false"); DrawerHost thêm lớp phủ mờ và thẻ drawer -->
    <StackPane fx:id="drawerLayer" styleClass="drawer-layer" pickOnBounds="false"/>

    <!-- Lớp phủ cho toast (F2); chỉ các toast nhận chuột -->
    <StackPane fx:id="toastLayer" styleClass="toast-layer" pickOnBounds="false"/>
</StackPane>
