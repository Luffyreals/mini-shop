<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.minishop</groupId>
    <artifactId>mini-shop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>mini-shop</name>
    <description>Ứng dụng desktop bán hàng mini (JavaFX) - dự án học tập / portfolio</description>
    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/license/mit</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.5.1</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <javafx.version>25.0.5</javafx.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
        <testfx.version>4.0.18</testfx.version>
        <imageio-webp.version>3.15.3</imageio-webp.version>
        <!-- Ghi đè bản 2.4.240 của Spring Boot BOM: 2.4.240 gắn CHECK (… in (…)) với kết nối đã tạo nó (kết nối
             Flyway), nên sau khi Hikari thay kết nối đó (maxLifetime 30 phút) mọi lệnh ghi bị CHECK đó kiểm đều lỗi.
             Đã sửa từ 2.5.250 (H2 issue #4302), xem PoolConnectionRetireIntegrationTest. Bỏ dòng này khi Boot lên 2.5.x. -->
        <h2.version>2.5.252</h2.version>
    </properties>

    <dependencies>
        <!-- Kiểm tra dữ liệu (Jakarta Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Dữ liệu -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Database nhúng duy nhất: lưu ra file data/minishop.mv.db, không cần cài gì thêm (ADR-0013) -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Giao diện desktop (ADR-0014). Không có trong Spring Boot BOM nên ghim phiên bản.
             Classifier hệ điều hành (win/linux/mac) do pom của OpenJFX tự chọn. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <!-- Bộ đọc WebP cho javax.imageio (TwelveMonkeys, giấy phép BSD-3-Clause). Cần vì JavaFX không giải mã
                 được WebP mà admin được tải ảnh WebP lên (spec 006); desktop.WebpDecoder giải mã ngoài luồng FX.
                 Không có trong Spring Boot BOM nên ghim phiên bản. Scope runtime: code chỉ dùng API javax.imageio,
                 nên không ai import nhầm lớp của TwelveMonkeys. -->
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>${imageio-webp.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Chỉ PasswordEncoder (băm mật khẩu), không kéo theo Spring Security đầy đủ. Version do BOM quản lý -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Kiểm tra kiến trúc (chiều phụ thuộc giữa các package). Không nằm trong Spring Boot BOM nên phải ghim phiên bản -->
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test giao diện JavaFX trên toolkit thật (@Tag("ui")); không dùng Monocle vì không có bản cho JavaFX 22+.
                 Không khai junit-jupiter nên dùng bản của Spring Boot BOM -->
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Chạy bằng ./mvnw javafx:run (classpath mode, nên lớp Launcher không extends Application).
                     Không dùng spring-boot-maven-plugin: fat jar là định dạng cho server (QĐ12). -->
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx-maven-plugin.version}</version>
                <configuration>
                    <mainClass>com.minishop.desktop.Launcher</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <!-- @{argLine} giữ agent của JaCoCo -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED -Dtestfx.robot=glass</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Báo cáo coverage tại target/site/jacoco; chưa đặt ngưỡng tối thiểu.
                     Nếu cấu hình argLine cho surefire sau này, dùng @{argLine} để không đè agent. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
