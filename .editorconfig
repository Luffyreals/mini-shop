# https://editorconfig.org — giữ định dạng thống nhất giữa các IDE
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Hai dấu cách cuối dòng là ngắt dòng trong Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
